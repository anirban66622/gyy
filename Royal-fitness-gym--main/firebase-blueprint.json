{
  "entities": {
    "Enquiry": {
      "title": "Enquiry",
      "description": "Gym membership enquiry",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "service": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "service", "message"]
    }
  },
  "firestore": {
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "Store user enquiries and contact requests"
    }
  }
}
